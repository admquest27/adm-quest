rules_version = '2';

// Tudo é negado, exceto o que está liberado abaixo.
service cloud.firestore {
  match /databases/{database}/documents {

    // O professor é identificado por uma marca na conta (custom claim),
    // aplicada por ferramentas/definir-professor.mjs. Nenhum e-mail fica aqui.
    function logado() {
      return request.auth != null;
    }

    function ehProfessor() {
      return logado() && request.auth.token.get('professor', false) == true;
    }

    function meuAluno() {
      return get(/databases/$(database)/documents/alunos/$(request.auth.uid)).data;
    }

    function temCadastro() {
      return logado() && exists(/databases/$(database)/documents/alunos/$(request.auth.uid));
    }

    function ativo() {
      return temCadastro() && meuAluno().status == 'ativo';
    }

    // Turma de teste: a única em que o professor pode apagar dados de alunos.
    function turmaDeTeste(turma) {
      return turma is string && turma != ''
        && get(/databases/$(database)/documents/turmas/$(turma)).data.get('teste', false) == true;
    }

    function estadoFase(turma, fase) {
      return get(/databases/$(database)/documents/turmas/$(turma)).data.get('estadoFases', {}).get(fase, 'trancada');
    }

    // Depois que a fase é encerrada, só faz quem faltou ou quem o professor liberou.
    function liberadoDepoisDeEncerrar(uid, fase) {
      return exists(/databases/$(database)/documents/avaliacoes/$(uid + '_' + fase))
        && (get(/databases/$(database)/documents/avaliacoes/$(uid + '_' + fase)).data.get('faltou', false) == true
            || get(/databases/$(database)/documents/avaliacoes/$(uid + '_' + fase)).data.get('liberado', false) == true);
    }

    function podeEditarFase(turma, fase, uid) {
      return estadoFase(turma, fase) == 'aberta'
        || (estadoFase(turma, fase) == 'encerrada' && liberadoDepoisDeEncerrar(uid, fase));
    }

    // Códigos de entrada: o aluno só consegue buscar um código que já sabe (get), nunca listar.
    match /codigos/{codigo} {
      allow get: if logado();
      allow list, write: if ehProfessor();
    }

    // Turmas: o aluno lê só a própria turma. Só o professor altera.
    match /turmas/{turma} {
      allow read: if ehProfessor() || (temCadastro() && meuAluno().turma == turma);
      allow write: if ehProfessor();
    }

    // Cadastro do aluno.
    match /alunos/{uid} {
      allow read: if ehProfessor() || (logado() && request.auth.uid == uid);

      // O aluno cria só o próprio documento, sempre "pendente", com um código válido e aberto.
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['turma', 'codigo', 'apelido', 'status', 'criadoEm'])
        && request.resource.data.keys().hasAll(['turma', 'codigo', 'apelido', 'status', 'criadoEm'])
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.apelido is string
        && request.resource.data.apelido.size() >= 2
        && request.resource.data.apelido.size() <= 16
        && request.resource.data.codigo is string
        && request.resource.data.codigo.matches('^[A-Z0-9]{4,10}$')
        && request.resource.data.turma is string
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.turma == request.resource.data.turma
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.aberta == true;

      // Aluno ativo só altera o avatar e o último acesso. O professor altera tudo.
      allow update: if ehProfessor()
        || (logado()
            && request.auth.uid == uid
            && resource.data.status == 'ativo'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'ultimoAcesso'])
            && (!('avatar' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.avatar is map
                    && request.resource.data.avatar.keys().hasOnly(['fantasia', 'tom'])
                    && request.resource.data.avatar.fantasia is string
                    && request.resource.data.avatar.fantasia.size() <= 20
                    && request.resource.data.avatar.tom is int
                    && request.resource.data.avatar.tom >= 0
                    && request.resource.data.avatar.tom <= 5))
            && (!('ultimoAcesso' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.ultimoAcesso == request.time));

      // O histórico não se apaga: o professor só recusa cadastros pendentes e limpa a turma de teste.
      allow delete: if ehProfessor()
        && (resource.data.status == 'pendente' || turmaDeTeste(resource.data.get('turma', '')));
    }

    // Conteúdo do mundo e das fases: o aluno ativo lê, só o professor altera.
    match /mundos/{id} {
      allow read: if ehProfessor() || ativo();
      allow write: if ehProfessor();
    }

    match /fases/{id} {
      allow read: if ehProfessor() || ativo();
      allow write: if ehProfessor();
    }

    // Notas "Para você", dossiês, enigmas e códigos: nunca visíveis ao aluno.
    match /fasesProfessor/{id} {
      allow read, write: if ehProfessor();
    }

    // Progresso do aluno em cada fase: tarefas marcadas, respostas e "concluí". O id é uid_fase.
    match /progresso/{pid} {
      allow read: if ehProfessor() || (logado() && resource.data.uid == request.auth.uid);

      allow create: if ativo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'turma', 'fase', 'tarefas', 'respostas', 'concluida', 'concluidaEm', 'atualizadoEm'])
        && request.resource.data.keys().hasAll(['uid', 'turma', 'fase', 'tarefas', 'concluida', 'atualizadoEm'])
        && request.resource.data.fase is string
        && pid == request.auth.uid + '_' + request.resource.data.fase
        && request.resource.data.turma == meuAluno().turma
        && podeEditarFase(request.resource.data.turma, request.resource.data.fase, request.auth.uid)
        && request.resource.data.tarefas is map
        && request.resource.data.tarefas.size() <= 30
        && (!('respostas' in request.resource.data) || request.resource.data.respostas is map)
        && request.resource.data.concluida is bool
        && request.resource.data.atualizadoEm == request.time
        && (!('concluidaEm' in request.resource.data) || request.resource.data.concluidaEm == request.time);

      allow update: if ativo()
        && resource.data.uid == request.auth.uid
        && podeEditarFase(resource.data.turma, resource.data.fase, request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tarefas', 'respostas', 'concluida', 'concluidaEm', 'atualizadoEm'])
        && request.resource.data.tarefas is map
        && request.resource.data.tarefas.size() <= 30
        && (!('respostas' in request.resource.data) || request.resource.data.respostas is map)
        && request.resource.data.concluida is bool
        && request.resource.data.atualizadoEm == request.time
        && (!('concluidaEm' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.concluidaEm == request.time
            || request.resource.data.concluidaEm == null);

      allow delete: if ehProfessor() && turmaDeTeste(resource.data.get('turma', ''));
    }

    // Calendário oficial, eventos do professor e plano de datas das turmas: só o professor.
    match /calendario/{ano} {
      allow read, write: if ehProfessor();
    }

    match /planos/{turma} {
      allow read, write: if ehProfessor();
    }

    // Comentários de atitudes: o aluno só lê os que o professor marcou como visíveis e que são dele.
    match /comentarios/{id} {
      allow read: if ehProfessor() || (logado() && resource.data.uid == request.auth.uid && resource.data.get('visivel', false) == true);
      allow create, update: if ehProfessor();
      allow delete: if ehProfessor() && turmaDeTeste(resource.data.get('turma', ''));
    }

    // Conversas anotadas pelo professor: só ele vê.
    match /anotacoes/{id} {
      allow read, write: if ehProfessor();
    }

    // Avaliações (falta, liberação, validação, A, PA, NA): o aluno lê só as próprias, só o professor escreve.
    match /avaliacoes/{pid} {
      allow read: if ehProfessor() || (logado() && resource.data.uid == request.auth.uid);
      allow write: if ehProfessor();
    }

    // ---------- Colegas, guildas e grupos ----------

    // Perfil público dentro da turma: só apelido, avatar e os enfeites em uso (ids da loja).
    // O próprio aluno mantém, sempre igual ao cadastro; os colegas da mesma turma leem.
    function idLoja(v) {
      return v is string && v.size() <= 30;
    }

    match /perfis/{uid} {
      allow read: if ehProfessor() || (ativo() && resource.data.turma == meuAluno().turma);
      allow create, update: if ehProfessor()
        || (ativo()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['turma', 'apelido', 'avatar', 'visual', 'atualizadoEm'])
            && request.resource.data.turma == meuAluno().turma
            && request.resource.data.apelido == meuAluno().apelido
            && request.resource.data.get('avatar', null) == meuAluno().get('avatar', null)
            && (!('visual' in request.resource.data)
                || (request.resource.data.visual is map
                    && request.resource.data.visual.keys().hasOnly(['titulo', 'moldura', 'fundo'])
                    && idLoja(request.resource.data.visual.get('titulo', ''))
                    && idLoja(request.resource.data.visual.get('moldura', ''))
                    && idLoja(request.resource.data.visual.get('fundo', ''))))
            && request.resource.data.atualizadoEm == request.time);
      allow delete: if ehProfessor();
    }

    // Configuração de cada atividade em grupo, guardada na turma: atividades.{id} = { modo, tamanho, aberta }.
    function atividade(turma, atv) {
      return get(/databases/$(database)/documents/turmas/$(turma)).data.get('atividades', {}).get(atv, {});
    }

    function alunosMontam(turma, atv) {
      return atividade(turma, atv).get('aberta', false) == true && atividade(turma, atv).get('modo', 'alunos') == 'alunos';
    }

    function tamanho(turma, atv) {
      return atividade(turma, atv).get('tamanho', 4);
    }

    function vaga(atv, uid) {
      return /databases/$(database)/documents/vagas/$(atv + '_' + uid);
    }

    // Grupo de uma atividade (ou guilda). Os alunos montam por convite: quem cria convida; cada convidado aceita ou recusa.
    match /grupos/{gid} {
      function eu() { return request.auth.uid; }
      function antes() { return resource.data; }
      function depois() { return request.resource.data; }
      function soMudou(campos) { return depois().diff(antes()).affectedKeys().hasOnly(campos); }

      function aceitar() {
        return antes().convites.hasAny([eu()])
          && depois().membros == antes().membros.concat([eu()])
          && depois().convites == antes().convites.removeAll([eu()])
          && depois().membros.size() <= tamanho(antes().turma, antes().atividade)
          && existsAfter(vaga(antes().atividade, eu()))
          && getAfter(vaga(antes().atividade, eu())).data.grupo == gid;
      }

      function recusar() {
        return antes().convites.hasAny([eu()])
          && depois().membros == antes().membros
          && depois().convites == antes().convites.removeAll([eu()]);
      }

      function convidar() {
        return antes().criador == eu()
          && depois().membros == antes().membros
          && depois().convites is list
          && !depois().convites.hasAny(antes().membros)
          && depois().membros.size() + depois().convites.size() <= tamanho(antes().turma, antes().atividade);
      }

      function sair() {
        return antes().membros.hasAny([eu()])
          && antes().criador != eu()
          && depois().membros == antes().membros.removeAll([eu()])
          && depois().convites == antes().convites
          && !existsAfter(vaga(antes().atividade, eu()));
      }

      // Nome e escudo da guilda: um integrante propõe, os outros confirmam, o professor aprova.
      function propostaValida(p) {
        return p is map
          && p.keys().hasOnly(['nome', 'escudo', 'por', 'confirmacoes'])
          && p.nome is string && p.nome.size() >= 2 && p.nome.size() <= 24
          && p.escudo is map && p.escudo.keys().hasOnly(['forma', 'cor1', 'cor2', 'simbolo'])
          && p.escudo.forma is string && p.escudo.forma.size() <= 12
          && p.escudo.cor1 is string && p.escudo.cor1.size() <= 9
          && p.escudo.cor2 is string && p.escudo.cor2.size() <= 9
          && p.escudo.simbolo is string && p.escudo.simbolo.size() <= 12
          && p.confirmacoes is list;
      }

      function propor() {
        return antes().membros.hasAny([eu()])
          && propostaValida(depois().proposta)
          && depois().proposta.por == eu()
          && depois().proposta.confirmacoes == [eu()];
      }

      function confirmar() {
        return antes().membros.hasAny([eu()])
          && 'proposta' in antes()
          && !antes().proposta.confirmacoes.hasAny([eu()])
          && depois().proposta.nome == antes().proposta.nome
          && depois().proposta.escudo == antes().proposta.escudo
          && depois().proposta.por == antes().proposta.por
          && depois().proposta.confirmacoes == antes().proposta.confirmacoes.concat([eu()]);
      }

      allow read: if ehProfessor() || (ativo() && resource.data.turma == meuAluno().turma);

      allow create: if ehProfessor()
        || (ativo()
            && depois().keys().hasOnly(['turma', 'atividade', 'membros', 'convites', 'criador', 'criadoEm'])
            && depois().turma == meuAluno().turma
            && depois().atividade is string
            && alunosMontam(depois().turma, depois().atividade)
            && depois().criador == eu()
            && depois().membros == [eu()]
            && depois().convites is list
            && !depois().convites.hasAny([eu()])
            && depois().convites.size() + 1 <= tamanho(depois().turma, depois().atividade)
            && depois().criadoEm == request.time
            && existsAfter(vaga(depois().atividade, eu())));

      allow update: if ehProfessor()
        || (ativo()
            && antes().turma == meuAluno().turma
            && ((soMudou(['membros', 'convites'])
                 && alunosMontam(antes().turma, antes().atividade)
                 && (aceitar() || recusar() || convidar() || sair()))
                || (soMudou(['proposta']) && (propor() || confirmar()))));

      allow delete: if ehProfessor()
        || (ativo()
            && antes().turma == meuAluno().turma
            && antes().criador == eu()
            && antes().membros == [eu()]
            && alunosMontam(antes().turma, antes().atividade)
            && !existsAfter(vaga(antes().atividade, eu())));
    }

    // Uma vaga por aluno em cada atividade: impede estar em dois grupos ao mesmo tempo. O id é atividade_uid.
    match /vagas/{vid} {
      allow read: if ehProfessor() || (logado() && resource.data.uid == request.auth.uid);
      allow create: if ehProfessor()
        || (ativo()
            && request.resource.data.keys().hasOnly(['uid', 'turma', 'atividade', 'grupo'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.turma == meuAluno().turma
            && request.resource.data.atividade is string
            && vid == request.resource.data.atividade + '_' + request.auth.uid
            && request.resource.data.grupo is string
            && existsAfter(/databases/$(database)/documents/grupos/$(request.resource.data.grupo))
            && getAfter(/databases/$(database)/documents/grupos/$(request.resource.data.grupo)).data.membros.hasAny([request.auth.uid])
            && getAfter(/databases/$(database)/documents/grupos/$(request.resource.data.grupo)).data.atividade == request.resource.data.atividade);
      allow update: if ehProfessor();
      allow delete: if ehProfessor()
        || (logado()
            && resource.data.uid == request.auth.uid
            && (!existsAfter(/databases/$(database)/documents/grupos/$(resource.data.grupo))
                || !getAfter(/databases/$(database)/documents/grupos/$(resource.data.grupo)).data.membros.hasAny([request.auth.uid])));
    }

    // ---------- Votações (cenário das bifurcações, nome do reino) ----------
    // O professor abre e encerra; a turma lê. Cada aluno tem um voto por votação (id votacao_uid),
    // que pode mudar enquanto ela está aberta. Ninguém vê o voto do colega; o resultado é publicado pelo professor.
    match /votacoes/{vid} {
      allow read: if ehProfessor() || (ativo() && resource.data.turma == meuAluno().turma);
      allow write: if ehProfessor();
    }

    function votacao(vid) {
      return get(/databases/$(database)/documents/votacoes/$(vid)).data;
    }

    match /votos/{id} {
      allow read: if ehProfessor() || (logado() && resource.data.uid == request.auth.uid);
      allow create, update: if ativo()
        && request.resource.data.keys().hasOnly(['uid', 'turma', 'votacao', 'opcao', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.votacao is string
        && id == request.resource.data.votacao + '_' + request.auth.uid
        && request.resource.data.turma == meuAluno().turma
        && votacao(request.resource.data.votacao).turma == meuAluno().turma
        && votacao(request.resource.data.votacao).estado == 'aberta'
        && votacao(request.resource.data.votacao).opcoesIds.hasAny([request.resource.data.opcao])
        && request.resource.data.em == request.time;
      allow delete: if ehProfessor();
    }

    // ---------- Castelo do chefão: baús com código ----------
    // O código certo de cada baú existe só como id de documento em "chaves" (fase_bau_CODIGO), que nenhum aluno lê.
    // A guilda abre o baú criando um "acerto"; a regra confere se a chave existe. Errar só recusa a gravação.
    match /chaves/{id} {
      allow read, write: if ehProfessor();
    }

    match /acertos/{id} {
      allow read: if ehProfessor() || (ativo() && resource.data.turma == meuAluno().turma);
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['turma', 'fase', 'bau', 'grupo', 'codigo', 'uid', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.turma == meuAluno().turma
        && request.resource.data.fase is string && request.resource.data.bau is string
        && request.resource.data.grupo is string
        && request.resource.data.codigo is string && request.resource.data.codigo.matches('^[A-Z0-9]{1,20}$')
        && id == request.resource.data.turma + '_' + request.resource.data.fase + '_' + request.resource.data.bau + '_' + request.resource.data.grupo
        && estadoFase(request.resource.data.turma, request.resource.data.fase) == 'aberta'
        && get(/databases/$(database)/documents/grupos/$(request.resource.data.grupo)).data.membros.hasAny([request.auth.uid])
        && get(/databases/$(database)/documents/grupos/$(request.resource.data.grupo)).data.turma == meuAluno().turma
        && exists(/databases/$(database)/documents/chaves/$(request.resource.data.fase + '_' + request.resource.data.bau + '_' + request.resource.data.codigo))
        && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if ehProfessor();
    }

    // AdmBux: loja, conquistas e valores. O aluno ativo lê; só o professor altera.
    match /economia/{id} {
      allow read: if ehProfessor() || ativo();
      allow write: if ehProfessor();
    }

    // Carteira: prêmios e rendimentos que só o professor dá. O aluno lê só a própria.
    match /carteiras/{uid} {
      allow read: if ehProfessor() || (logado() && request.auth.uid == uid);
      allow write: if ehProfessor();
    }

    // Compras do aluno: a lista só cresce, um item por vez, com o preço da loja. Nada se apaga.
    function itemValido(item) {
      return item is map
        && item.keys().hasOnly(['id', 'preco', 'em'])
        && item.id is string
        && item.preco is int
        && item.em is int
        && get(/databases/$(database)/documents/economia/geral).data.loja.get(item.id, {}).get('preco', -1) == item.preco;
    }

    function usandoValido(u) {
      return u is map && u.keys().hasOnly(['moldura', 'fundo', 'titulo']);
    }

    match /compras/{uid} {
      allow read: if ehProfessor() || (logado() && request.auth.uid == uid);

      allow create: if ativo()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'turma', 'itens', 'usando', 'atualizadoEm'])
        && request.resource.data.uid == uid
        && request.resource.data.turma == meuAluno().turma
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 1
        && (request.resource.data.itens.size() == 0 || itemValido(request.resource.data.itens[0]))
        && usandoValido(request.resource.data.get('usando', {}))
        && request.resource.data.atualizadoEm == request.time;

      allow update: if ativo()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itens', 'usando', 'atualizadoEm'])
        && request.resource.data.itens is list
        && request.resource.data.itens.hasAll(resource.data.itens)
        && request.resource.data.itens.size() <= 200
        && (request.resource.data.itens.size() == resource.data.itens.size()
            || (request.resource.data.itens.size() == resource.data.itens.size() + 1
                && itemValido(request.resource.data.itens[request.resource.data.itens.size() - 1])))
        && usandoValido(request.resource.data.get('usando', {}))
        && request.resource.data.atualizadoEm == request.time;

      allow delete: if ehProfessor() && turmaDeTeste(resource.data.get('turma', ''));
    }
  }
}
